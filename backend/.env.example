# Copy to .env in this folder. Loaded automatically by the server (dotenv).
#
# Kiosk Express (avoid 3001 — that is the beach-hotel booking API in typical dev)
PORT=3004

# Menu-management Nest API (must expose GET /api/v1/kiosk/menu). Not the booking app.
MENU_APP_URL=http://localhost:3002

# Beach-hotel booking Nest API (validate-guest, charge-booking, etc.)
BOOKING_APP_URL=http://localhost:3001

# Spending limits (in PHP)
ORDER_CAP=5000
DAILY_CAP=15000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@playamontana.com
